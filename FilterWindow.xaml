<Window x:Class="MeshDraw.FilterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MeshDraw · Filters" Width="1080" Height="760" MinWidth="840" MinHeight="580" WindowStartupLocation="CenterOwner" Background="#11151D" Foreground="#EDF3F8">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#273448"/><Setter Property="Foreground" Value="#EDF3F8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Foreground" Value="#182335"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#182335"/><Setter Property="Padding" Value="6"/></Style>
  <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#E1E5EA" Geometry="M0,0 H20 V20 H0 Z"/><GeometryDrawing Brush="#B7C0CA" Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z"/></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
 </Window.Resources>
 <Grid Margin="20" Background="#11151D">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="Filters" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="TargetLabel" Foreground="#A6B7CD" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="Search filters" Foreground="#A6B7CD"/><TextBox x:Name="Search" Grid.Row="1" TextChanged="SearchChanged"/>
    <ComboBox x:Name="Category" Grid.Row="2" SelectionChanged="CategoryChanged" Margin="0,0,0,10"/>
    <ListBox x:Name="FilterList" Grid.Row="3" DisplayMemberPath="Name" Background="#192230" Foreground="#EDF3F8" SelectionChanged="FilterChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   </Grid>
   <Grid Grid.Column="1" Margin="0,0,16,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="FilterTitle" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,5,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Before" HorizontalAlignment="Center" Margin="0,0,0,6"/><Border Grid.Row="1" Background="{StaticResource Checker}"><Image x:Name="Before" Stretch="Uniform"/></Border></Grid>
     <Grid Grid.Column="1" Margin="5,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="After" HorizontalAlignment="Center" Margin="0,0,0,6"/><Border Grid.Row="1" Background="{StaticResource Checker}"><Image x:Name="After" Stretch="Uniform"/></Border></Grid>
    </Grid>
    <ProgressBar x:Name="Loading" Grid.Row="2" Height="8" IsIndeterminate="True" Visibility="Collapsed" Margin="0,12,0,0"/>
    <TextBlock x:Name="Message" Grid.Row="3" Foreground="#A6B7CD" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </Grid>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="SETTINGS" Foreground="#8FA4C2" Margin="0,0,0,12"/><StackPanel x:Name="Controls"/><TextBlock Text="Effect opacity"/><Slider x:Name="Amount" Minimum="0" Maximum="1" Value="1" ValueChanged="AmountChanged" Margin="0,8"/><TextBlock x:Name="Note" TextWrapping="Wrap" Foreground="#A6B7CD" Margin="0,10,0,0"/><Button Content="Reset settings" Click="ResetSettings" Margin="0,18,0,0"/></StackPanel></ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="Local filter equivalents · edits only this layer · Undo supported" TextWrapping="Wrap" Foreground="#8FA4C2" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Cancel" Click="Cancel"/><Button x:Name="ApplyButton" Content="Apply" Click="Apply"/></StackPanel></DockPanel>
 </Grid>
</Window>
