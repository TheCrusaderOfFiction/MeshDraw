<Window x:Class="MeshDraw.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MeshDraw · Drawing Studio" Width="1440" Height="960" MinWidth="1040" MinHeight="740" Background="#11151D" Foreground="#EDF3F8">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="#273448"/><Setter Property="Foreground" Value="#F1F6FC"/><Setter Property="BorderBrush" Value="#3B4A61"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,5"/><Setter Property="Foreground" Value="#182335"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Background" Value="#EAF0F6"/><Setter Property="Foreground" Value="#182335"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5,12,5"/><Setter Property="Foreground" Value="#EDF3F8"/></Style>
  <Style TargetType="GridSplitter">
   <Setter Property="Background" Value="#354155"/><Setter Property="ShowsPreview" Value="False"/>
   <Setter Property="Focusable" Value="True"/><Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5CA7DB"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#5CA7DB"/></Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid x:Name="AppScreen">
 <Grid x:Name="EditorScreen" Margin="16" Background="#11151D" Visibility="Collapsed">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition MinHeight="240"/><RowDefinition Height="8"/><RowDefinition x:Name="BottomPanelRow" Height="230" MinHeight="70" MaxHeight="440"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14"><TextBlock Text="MeshDraw" FontWeight="Bold" FontSize="26" Margin="0,0,28,0" DockPanel.Dock="Left"/><WrapPanel><Button Content="← My gallery" Click="ShowDrawingLibrary"/><Button Content="Save" Click="SaveProject"/><Button Content="Save a copy" Click="SaveDrawingCopy"/><Button Content="Export layers" Click="ExportDrawings"/><Button Content="Undo" Click="Undo"/><Button Content="Redo" Click="Redo"/><Button Content="Clear layer" Click="ClearLayer"/><Button Content="Import photo" Click="ImportPhoto"/><Button Content="Filters" Click="OpenFilters"/></WrapPanel></DockPanel>
  <Grid x:Name="DrawingWorkspace" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftPanelColumn" Width="140" MinWidth="120" MaxWidth="320"/><ColumnDefinition Width="8"/><ColumnDefinition MinWidth="280"/><ColumnDefinition Width="8"/><ColumnDefinition x:Name="RightPanelColumn" Width="330" MinWidth="240" MaxWidth="560"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,6,0">
    <TextBlock Text="TOOLS" Foreground="#8FA4C2"/>
    <UniformGrid Columns="2" Margin="0,8,0,0"><Button x:Name="PenTool" Content="Pen" Tag="0" Click="SelectPaintTool"/><Button x:Name="EraseTool" Content="Eraser" Tag="1" Click="SelectPaintTool"/><Button Content="Bone" Tag="2" Click="SelectPaintTool"/><Button Content="Joint" Tag="3" Click="SelectPaintTool"/><Button x:Name="BlurTool" Content="Blur" Tag="4" Click="SelectPaintTool"/><Button x:Name="SmudgeTool" Content="Smudge" Tag="5" Click="SelectPaintTool"/><Button x:Name="BucketTool" Content="Bucket" Tag="6" Click="SelectPaintTool"/><Button x:Name="MoveLayerTool" Content="Move" Tag="7" Click="SelectPaintTool"/><Button x:Name="SelectionTool" Content="Select" Tag="8" Click="SelectPaintTool"/><Button x:Name="EdgeGuideTool" Content="Edges" Tag="9" Click="SelectPaintTool"/></UniformGrid>
    <ComboBox x:Name="Tool" Visibility="Collapsed" SelectionChanged="ToolChanged"><ComboBoxItem Content="Brush" IsSelected="True"/><ComboBoxItem Content="Eraser"/><ComboBoxItem Content="Draw bone"/><ComboBoxItem Content="Move joint"/><ComboBoxItem Content="Blur"/><ComboBoxItem Content="Smudge"/><ComboBoxItem Content="Bucket"/><ComboBoxItem Content="Move layer"/><ComboBoxItem Content="Selection"/><ComboBoxItem Content="Edge marks"/></ComboBox>
   </StackPanel></ScrollViewer>
   <GridSplitter x:Name="LeftPanelDivider" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" Cursor="SizeWE" ToolTip="Drag to resize tools"/>
   <Grid Grid.Column="2" Margin="6,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel><WrapPanel><Button Content="Single view" Tag="single" Click="ChangeViewLayout"/><Button Content="All views" Tag="all" Click="ChangeViewLayout"/><Button Content="Copy face…" Click="OpenFaceCopy"/><Button Content="3D outline preview" Tag="3d" Click="ChangeViewLayout"/></WrapPanel><WrapPanel x:Name="FaceSelection"/><CheckBox x:Name="ShowOppositeShadow" Content="Show opposite face shadow" IsChecked="True" Checked="ShadowChanged" Unchecked="ShadowChanged"/></StackPanel>
    <Grid Grid.Row="1">
     <TabControl x:Name="Views" SelectionChanged="ViewChanged" Background="#242D3A" Foreground="#182335"/>
     <UniformGrid x:Name="AllViews" Columns="3" Rows="2" Visibility="Collapsed"/>
     <Grid x:Name="OutlinePreviewScreen" Visibility="Collapsed" Background="#192230"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Viewport3D x:Name="OutlineViewport" ClipToBounds="True" Focusable="True" KeyDown="PreviewFaceKey" LostMouseCapture="PreviewFaceCaptureLost" MouseLeftButtonDown="PreviewOrbitDown" MouseMove="PreviewOrbitMove" MouseLeftButtonUp="PreviewOrbitUp" MouseWheel="PreviewZoom"/>
      <Border x:Name="PreviewLoadingOverlay" Visibility="Collapsed" Background="#D0192230" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12"><StackPanel Width="260"><TextBlock x:Name="PreviewLoadingText" Text="Loading preview…" Margin="0,0,0,12"/><ProgressBar x:Name="PreviewLoadingBar" Height="12" Minimum="0" Maximum="100"/></StackPanel></Border>
      <StackPanel Grid.Row="1" Margin="12"><WrapPanel><Button x:Name="PreviewRefreshButton" Content="Refresh preview" Click="RefreshOutlinePreview"/><Button Content="Reset camera" Click="ResetPreviewCamera"/><TextBlock Text="Quality" VerticalAlignment="Center" Margin="10,0,6,0"/><Slider x:Name="PreviewQuality" Width="160" Minimum="16" Maximum="72" Value="28" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="8" VerticalAlignment="Center" ValueChanged="PreviewQualityChanged" PreviewMouseLeftButtonUp="PreviewQualityDragFinished" ToolTip="16 = fastest · 72 = most detail"/><TextBox x:Name="PreviewQualityInput" Width="52" Text="28" Margin="8,0" VerticalAlignment="Center" MaxLength="4" LostFocus="PreviewQualityCommitted" KeyDown="PreviewQualityKeyDown" ToolTip="Quality: 16–72. Press Enter to apply."/><CheckBox x:Name="ShowOutlinePlanes" Content="Show outline planes" IsChecked="True" Checked="PreviewFlagsChanged" Unchecked="PreviewFlagsChanged"/><CheckBox x:Name="ShowOverlapVolume" Content="Show overlap" IsChecked="True" Checked="PreviewFlagsChanged" Unchecked="PreviewFlagsChanged"/></WrapPanel><WrapPanel Margin="0,8,0,8"><TextBlock Text="Custom face" VerticalAlignment="Center"/><ComboBox x:Name="PreviewFace" Width="150" Margin="8,0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="PreviewFaceSelected"/><ComboBox x:Name="PreviewFaceMode" Width="130" SelectedIndex="0"><ComboBoxItem Content="Orbit camera"/><ComboBoxItem Content="Move face"/><ComboBoxItem Content="Rotate face"/></ComboBox><ComboBox x:Name="PreviewFaceAxis" Width="155" SelectedIndex="0"><ComboBoxItem Content="Screen / yaw-pitch"/><ComboBoxItem Content="X / yaw"/><ComboBoxItem Content="Y / pitch"/><ComboBoxItem Content="Z / roll"/></ComboBox><StackPanel Orientation="Horizontal" ToolTip="Position relative to the original cube: −2 to +2"><TextBlock Text="Position X Y Z" VerticalAlignment="Center" Margin="8,0"/><TextBox x:Name="PreviewFaceX" Width="45"/><TextBox x:Name="PreviewFaceY" Width="45"/><TextBox x:Name="PreviewFaceZ" Width="45"/></StackPanel><StackPanel Orientation="Horizontal" ToolTip="Rotation in degrees"><TextBlock Text="Yaw Pitch Roll" VerticalAlignment="Center" Margin="8,0"/><TextBox x:Name="PreviewFaceYaw" Width="45"/><TextBox x:Name="PreviewFacePitch" Width="45"/><TextBox x:Name="PreviewFaceRoll" Width="45"/></StackPanel><Button Content="Apply" Click="ApplyPreviewFace"/><Button Content="Reset face" Click="ResetPreviewFace"/></WrapPanel><TextBlock x:Name="OutlinePreviewStatus" TextWrapping="Wrap" Foreground="#A6B7CD"/><TextBlock Text="Choose a custom face, then drag to move or rotate it · Orbit camera mode rotates the view · Scroll to zoom" FontSize="11" Foreground="#8FA4C2" Margin="0,6,0,0"/></StackPanel>
     </Grid>
    </Grid>
   </Grid>
   <GridSplitter x:Name="RightPanelDivider" Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" Cursor="SizeWE" ToolTip="Drag to resize layers and skeleton"/>
   <ScrollViewer Grid.Column="4" Margin="6,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Expander Foreground="#EDF3F8" x:Name="RulerSettings" Header="Ruler" Margin="0,0,0,8"><StackPanel>    <TextBlock Text="DRAWING AIDS" Foreground="#8FA4C2" Margin="0,18,0,5"/>
    <ComboBox x:Name="RulerMode" SelectionChanged="DrawingAidChanged"><ComboBoxItem Content="Ruler off" IsSelected="True"/><ComboBoxItem Content="Straight ruler"/><ComboBoxItem Content="Circular ruler"/></ComboBox>
    <CheckBox x:Name="PositionRuler" Content="Move ruler mode" Checked="DrawingAidChanged" Unchecked="DrawingAidChanged"/>
    <Button Content="Reset ruler position" Click="ResetRulerPosition"/><TextBlock Text="Angle (degrees)" FontSize="11"/><TextBox x:Name="RulerAngleInput" Text="0" LostFocus="RulerNumberCommitted" KeyDown="RulerNumberKeyDown"/><Slider x:Name="RulerAngle" Minimum="-180" Maximum="180" Value="0" ValueChanged="DrawingAidValueChanged"/>
    <TextBlock Text="Radius (pixels)" FontSize="11"/><TextBox x:Name="RulerRadiusInput" Text="192" LostFocus="RulerNumberCommitted" KeyDown="RulerNumberKeyDown"/><Slider x:Name="RulerRadius" Minimum="0.05" Maximum="0.48" Value="0.3" ValueChanged="DrawingAidValueChanged"/>
<TextBlock Text="Drag center or edge handles to adjust. Draw anywhere: parallel lines or concentric arcs." FontSize="11" Foreground="#8FA4C2" TextWrapping="Wrap"/></StackPanel></Expander><Expander Foreground="#EDF3F8" x:Name="StabilizerSettings" Header="Stabilizer and fade" Margin="0,0,0,12"><StackPanel>    <TextBlock Text="Stabilizer" FontSize="11" Margin="0,8,0,0"/><ComboBox x:Name="StabilizerMethod"><ComboBoxItem Content="Real time · smooth while drawing" IsSelected="True"/><ComboBoxItem Content="After · smooth on release"/></ComboBox><TextBlock Text="0 = off · 20 = strongest" FontSize="11" Foreground="#8FA4C2"/><Slider x:Name="StrokeStabilizer" Minimum="0" Maximum="20" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"/>
    <CheckBox x:Name="StrokeFade" Content="Fade ends"/><Slider x:Name="FadeAmount" Minimum="0.02" Maximum="0.45" Value="0.15" ToolTip="Fade length at each end"/>
    
</StackPanel></Expander>
    <Expander x:Name="ExtraFacesSettings" Header="Extra faces · angles and slices" Foreground="#EDF3F8" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="Face name"/><TextBox x:Name="ExtraFaceName" Text="Extra face" MaxLength="40"/>
     <ComboBox x:Name="ExtraFaceType"><ComboBoxItem Content="Angled silhouette" IsSelected="True"/><ComboBoxItem Content="Interior cross-section (sandwich)"/></ComboBox>
     <TextBlock Text="Yaw (−180 to 180°) · Pitch (−90 to 90°)" FontSize="11"/><UniformGrid Columns="2"><TextBox x:Name="ExtraFaceYaw" Text="45" Margin="0,0,4,0"/><TextBox x:Name="ExtraFacePitch" Text="0"/></UniformGrid>
     <TextBlock Text="Slice position · −1 far side / 0 middle / +1 near side" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/><Slider x:Name="ExtraFaceOffset" Minimum="-.95" Maximum=".95" Value="0" TickFrequency=".05" IsSnapToTickEnabled="True"/>
     <TextBlock Text="{Binding ElementName=ExtraFaceOffset, Path=Value, StringFormat={}{0:0.00}}"/>
     <TextBlock Text="Interior face behavior" Margin="0,8,0,0"/><ComboBox x:Name="ExtraFaceSectionMode" SelectedIndex="0"><ComboBoxItem Content="Separate sections"/><ComboBoxItem Content="Smooth transition"/><ComboBoxItem Content="Legacy slice constraint"/></ComboBox><CheckBox x:Name="ExtraFaceReverse" Content="Reverse which side this face controls"/><TextBlock Text="Separate sections: the outer outline stops at this plane; this outline continues toward the opposite side. Move and rotate the plane in 3D to place the boundary." TextWrapping="Wrap" FontSize="11" Foreground="#A6B7CD"/>
     <WrapPanel><Button Content="Add face" Click="AddExtraFace"/><Button x:Name="ExtraFaceApply" Content="Apply to selected" Click="ApplyExtraFace" IsEnabled="False"/><Button x:Name="ExtraFaceDelete" Content="Remove face" Click="DeleteExtraFace" IsEnabled="False"/></WrapPanel>
     <TextBlock Text="0° faces front; 90° faces right. Pitch 90° faces up. Slices sit inside the object along that direction. Draw aligned, closed outlines; use the 3D preview to check placement." TextWrapping="Wrap" FontSize="11" Foreground="#8FA4C2"/>
    </StackPanel></Expander>
    <TextBlock x:Name="SelectionStatus" Text="Selection layer · none" Foreground="#8FA4C2" TextWrapping="Wrap"/><WrapPanel><Button Content="Selection layer" Click="SelectSelectionLayer"/><Button Content="Clear selection" Click="ClearSelection"/></WrapPanel>
    <TextBlock Text="Photo import as" Foreground="#8FA4C2"/><ComboBox x:Name="PhotoImportKind"><ComboBoxItem Content="Reference · trace over it" IsSelected="True"/><ComboBoxItem Content="Color · use in texture"/></ComboBox><TextBlock Text="LAYERS" FontWeight="Bold" Foreground="#8FA4C2"/><TextBlock Text="Outline on top · Color underneath" Foreground="#A6B7CD" Margin="0,5"/><WrapPanel><Button Content="Outline" Tag="0" Click="SelectCoreLayer"/><Button Content="Color" Tag="1" Click="SelectCoreLayer"/></WrapPanel>
    <ComboBox x:Name="NewLayerKind"><ComboBoxItem Content="Outline" IsSelected="True"/><ComboBoxItem Content="Color / Base Color"/><ComboBoxItem Content="Roughness"/><ComboBoxItem Content="Metallic"/><ComboBoxItem Content="Emission"/><ComboBoxItem Content="Height / Bump"/></ComboBox>
    <WrapPanel><Button Content="Flip horizontal" Tag="horizontal" Click="FlipLayer"/><Button Content="Flip vertical" Tag="vertical" Click="FlipLayer"/><Button Content="Move layer" Tag="7" Click="SelectPaintTool"/></WrapPanel>
    <WrapPanel><Button Content="+ Layer" Click="AddLayer"/><Button Content="Duplicate" Click="DuplicateLayer"/><Button Content="Delete" Click="DeleteLayer"/></WrapPanel>
    <ListBox x:Name="Layers" Height="215" Background="#192230" BorderBrush="#354155" SelectionChanged="LayerSelected" HorizontalContentAlignment="Stretch" Foreground="#EDF3F8" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2,4"><Image Source="{Binding Thumbnail}" Width="44" Height="44" DockPanel.Dock="Left" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="#8FA4C2"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <DockPanel><Button Content="Rename" Click="RenameLayer" DockPanel.Dock="Right"/><TextBox x:Name="LayerName" MinWidth="80"/></DockPanel>
    <WrapPanel><Button Content="Move up" Click="MoveLayerUp"/><Button Content="Move down" Click="MoveLayerDown"/><CheckBox x:Name="LayerVisible" Content="Visible" Checked="LayerFlagsChanged" Unchecked="LayerFlagsChanged"/><CheckBox x:Name="LayerLocked" Content="Lock" Checked="LayerFlagsChanged" Unchecked="LayerFlagsChanged"/></WrapPanel>
    <TextBlock Text="Layer opacity" Foreground="#8FA4C2"/><Slider x:Name="LayerOpacity" Minimum="0" Maximum="1" ValueChanged="LayerOpacityChanged" PreviewMouseLeftButtonUp="OpacityCommit" LostKeyboardFocus="OpacityCommit"/>
    <TextBlock Text="SKELETON" FontWeight="Bold" Foreground="#8FA4C2" Margin="0,20,0,0"/><WrapPanel><CheckBox x:Name="ShowRig" Content="Show overlay" IsChecked="True" Checked="RigVisibilityChanged" Unchecked="RigVisibilityChanged"/><Button Content="Save skeleton type" Click="SaveSkeletonType"/></WrapPanel>
    <ComboBox x:Name="EditorSkeletonTypes"/><Button Content="Apply skeleton type" Click="ApplySkeletonType"/><ComboBox x:Name="BoneList" DisplayMemberPath="Name" SelectionChanged="BoneSelected"/><DockPanel><Button Content="Rename" Click="RenameBone" DockPanel.Dock="Right"/><TextBox x:Name="BoneName" MinWidth="80"/></DockPanel><Button Content="Delete bone + children" Click="DeleteBone"/>
    <TextBlock Text="Draw bone: drag from a joint. Move joint: adjust it in front and side views." TextWrapping="Wrap" Foreground="#A6B7CD" FontSize="12"/>
    <TextBlock Text="LOCAL GENERATION" FontWeight="Bold" Foreground="#8FA4C2" Margin="0,20,0,0"/><ComboBox x:Name="Output" SelectionChanged="OutputChanged"><ComboBoxItem Content="Static Mesh" IsSelected="True"/><ComboBoxItem Content="Skeletal Mesh"/></ComboBox><TextBlock Text="Maximum vertices" Margin="0,10,0,4"/><TextBox x:Name="VertexLimitInput" Text="50000" LostKeyboardFocus="CommitVertexLimit" KeyDown="VertexLimitKey"/><Slider x:Name="VertexLimitSlider" Minimum="256" Maximum="100000" Value="50000" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VertexLimitChanged" PreviewMouseLeftButtonUp="CommitVertexLimit" LostKeyboardFocus="CommitVertexLimit"/><TextBlock Text="Lower limits reduce detail. Includes extra vertices needed at texture seams." TextWrapping="Wrap" Foreground="#A6B7CD" FontSize="12"/><TextBlock x:Name="BackendStatus" TextWrapping="Wrap" Foreground="#A6B7CD" FontSize="12"/>
    <WrapPanel><Button x:Name="GenerateButton" Content="Generate locally" Click="GenerateMesh"/><Button x:Name="CancelButton" Content="Cancel" Click="CancelGeneration" IsEnabled="False"/><Button x:Name="ResultButton" Content="Open output folder" Click="OpenResult" IsEnabled="False"/><Button x:Name="GenerationLogButton" Content="View generation log" Click="OpenGenerationLog" IsEnabled="False"/></WrapPanel><Button x:Name="UnrealExportButton" Content="Export Unreal file" Click="ExportUnreal" ToolTip="Packages the last generated snapshot. Regenerate after editing."/>
   </StackPanel></ScrollViewer>
  </Grid>
<GridSplitter x:Name="BottomPanelDivider" Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" Cursor="SizeNS" ToolTip="Drag up or down to resize tool settings"/>
<Border Grid.Row="3" Background="#192230" CornerRadius="12" Padding="16,10"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<StackPanel x:Name="SizeOpacitySettings"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="SizeLabel" Text="Size · 5 px" VerticalAlignment="Center" Margin="0,0,12,0"/><Slider x:Name="BrushSize" Grid.Column="1" Minimum="1" Maximum="80" Value="5" ValueChanged="BrushChanged" VerticalAlignment="Center"/><TextBlock x:Name="OpacityLabel" Grid.Column="2" Text="Opacity · 100%" VerticalAlignment="Center" Margin="22,0,12,0"/><Slider x:Name="BrushOpacity" Grid.Column="3" Minimum="0.05" Maximum="1" Value="1" ValueChanged="BrushChanged" VerticalAlignment="Center"/></Grid></StackPanel>
<WrapPanel>
<StackPanel x:Name="EdgeGuideSettings" Visibility="Collapsed" Width="470" Margin="0,10,20,0"><TextBlock Text="STRAIGHT EDGES &amp; SHARP CORNERS" Foreground="#8FA4C2"/><ComboBox x:Name="EdgeGuideMode"><ComboBoxItem Content="Straight edge · drag endpoints" IsSelected="True"/><ComboBoxItem Content="Sharp corner · tap point"/><ComboBoxItem Content="Erase mark · tap"/></ComboBox><TextBlock Text="Influence radius (px)"/><Slider x:Name="EdgeGuideRadius" Minimum="2" Maximum="64" Value="8" TickFrequency="1" IsSnapToTickEnabled="True"/><WrapPanel><Button Content="Remove last mark" Click="RemoveLastEdgeGuide"/><Button Content="Clear face marks" Click="ClearEdgeGuides"/><CheckBox x:Name="ShowEdgeGuides" Content="Show marks" IsChecked="True" Checked="EdgeGuideVisibilityChanged" Unchecked="EdgeGuideVisibilityChanged"/></WrapPanel><TextBlock Text="Place marks on the outline boundary. They guide geometry, not paint. Mark straight edges meeting at a corner for the cleanest result." TextWrapping="Wrap" Foreground="#A6B7CD"/></StackPanel>
<StackPanel x:Name="ColorSettings" Width="155" Margin="0,8,16,0">    <TextBlock Text="COLOR" Foreground="#8FA4C2" Margin="0,18,0,5"/><Button x:Name="ColorButton" Height="48" Content="Color" Click="OpenColorPicker"/><Button Content="Eyedropper" Click="SelectEyedropper"/>
    <TextBlock Text="Property value" Margin="0,16,0,4"/><Slider x:Name="PropertyValue" Minimum="0" Maximum="1" Value="0.5" ValueChanged="BrushChanged"/><TextBlock Text="Black 0 · White 1" Foreground="#8FA4C2" FontSize="11"/>
</StackPanel><StackPanel x:Name="SelectionSettings" Visibility="Collapsed" Margin="0,10,0,0"><TextBlock Text="SELECTION LAYER" Foreground="#8FA4C2"/><WrapPanel><Button Content="Brush selection" Tag="0" Click="SelectionDrawMode"/><Button Content="Erase selection" Tag="1" Click="SelectionDrawMode"/><Button Content="Shape selection" Tag="8" Click="SelectionDrawMode"/><Button Content="Use layer as mask" Click="UseLayerAsMask" ToolTip="Use the last selected paint layer’s nontransparent areas as the selection"/></WrapPanel><WrapPanel>
 <ComboBox x:Name="SelectionShape" Width="150"><ComboBoxItem Content="Rectangle" IsSelected="True"/><ComboBoxItem Content="Ellipse"/><ComboBoxItem Content="Lasso"/></ComboBox>
 <ComboBox x:Name="SelectionOperation" Width="150" Margin="8,5"><ComboBoxItem Content="Replace" IsSelected="True"/><ComboBoxItem Content="Add"/><ComboBoxItem Content="Subtract"/></ComboBox>
 <Button Content="Select all" Click="SelectEntireCanvas"/><Button Content="Invert" Click="InvertSelection"/><Button Content="Clear selection" Click="ClearSelection"/>
 </WrapPanel><TextBlock Text="Brush or erase the Selection layer, or use Shape selection. Choose a paint layer to draw inside the finished mask." TextWrapping="Wrap" Foreground="#A6B7CD"/></StackPanel>
<StackPanel x:Name="PenSettings" Width="170" Margin="0,8,16,0">    <TextBlock Text="BRUSH" Foreground="#8FA4C2" Margin="0,18,0,5"/><Button Content="Dip pen" Tag="pen" Click="BrushPreset"/><Button Content="Paint brush" Tag="paint" Click="BrushPreset" ToolTip="Wide translucent strokes"/><Button Content="Marker" Tag="marker" Click="BrushPreset"/>
</StackPanel><StackPanel x:Name="RasterSettings" Width="170" Margin="0,8,16,0">    <TextBlock Text="Tool strength" FontSize="11" Margin="0,8,0,0"/><Slider x:Name="RasterStrength" Minimum="0.05" Maximum="1" Value="0.5"/>
</StackPanel><StackPanel x:Name="BucketSettings" Width="200" Margin="0,8,16,0">    <TextBlock Text="Bucket tolerance" FontSize="11"/><Slider x:Name="BucketTolerance" Minimum="0" Maximum="100" Value="10"/><ComboBox x:Name="BucketReference"><ComboBoxItem Content="Outline + layer" IsSelected="True"/><ComboBoxItem Content="Selected layer"/></ComboBox>
</StackPanel></WrapPanel>    <TextBlock x:Name="ToolHint" TextWrapping="Wrap" Foreground="#A6B7CD" FontSize="12" Margin="0,22,0,0"/>
</StackPanel></ScrollViewer></Border>
  <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Right" StaysOpen="False" AllowsTransparency="True"><Border Background="#192230" BorderBrush="#556780" BorderThickness="1" CornerRadius="12" Padding="18" Width="300"><StackPanel>
   <TextBlock Text="Color" FontSize="20" Foreground="#EDF3F8"/><Grid x:Name="ColorSquare" Width="260" Height="180" Margin="0,14,0,8" MouseLeftButtonDown="ColorSquareDown" MouseMove="ColorSquareMove" MouseLeftButtonUp="ColorSquareUp"><Border x:Name="HueBackground" Background="Red"/><Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.Background></Border><Canvas IsHitTestVisible="False"><Ellipse x:Name="ColorCursor" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent"/></Canvas></Grid>
   <TextBlock Text="Hue" Foreground="#A6B7CD"/><Slider x:Name="HueSlider" Minimum="0" Maximum="360" ValueChanged="HueChanged" Height="30" Margin="0,4" ToolTip="Choose a hue" SmallChange="1" LargeChange="30">
    <Slider.Template><ControlTemplate TargetType="Slider"><Grid Margin="8,0">
     <Border Height="16" CornerRadius="8" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Red" Offset="0"/><GradientStop Color="Yellow" Offset="0.1666667"/><GradientStop Color="Lime" Offset="0.3333333"/><GradientStop Color="Cyan" Offset="0.5"/><GradientStop Color="Blue" Offset="0.6666667"/><GradientStop Color="Magenta" Offset="0.8333333"/><GradientStop Color="Red" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Track x:Name="PART_Track" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Margin="0" Padding="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="16" Height="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#60304050" BorderBrush="White" BorderThickness="2" CornerRadius="6"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Margin="0" Padding="0" Focusable="False"/></Track.IncreaseRepeatButton></Track>
    </Grid></ControlTemplate></Slider.Template>
   </Slider><TextBlock Text="Hex color" Foreground="#A6B7CD" Margin="0,10,0,4"/><TextBox x:Name="BrushHex" Text="#253341" LostFocus="BrushColorChanged"/><WrapPanel x:Name="ColorPalette" Margin="0,10,0,0"/><TextBlock Text="Recent colors" Foreground="#A6B7CD" Margin="0,10,0,4"/><WrapPanel x:Name="RecentColors"/><Button Content="Done" Click="CloseColorPicker"/>
  </StackPanel></Border></Popup>
  <TextBlock x:Name="Status" Grid.Row="4" Text="Ready. Draw outlines, then paint on the Color layer." Foreground="#A6B7CD" Margin="0,12,0,0" TextWrapping="Wrap" MaxHeight="46"/>
 </Grid>
 <Grid x:Name="GalleryScreen" Margin="36" Background="#11151D">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="MeshDraw" FontSize="15" Foreground="#8FA4C2"/><TextBlock Text="My gallery" FontSize="34" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel><WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="+ New drawing" Click="CreateGalleryDrawing"/><Button Content="Import drawing" Click="ImportGalleryDrawing"/></WrapPanel></DockPanel>
  <TextBlock Text="Your drawings, layers, colors, and skeletons — saved on this laptop." Grid.Row="1" Foreground="#A6B7CD" Margin="0,12,0,24"/>
  <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="GalleryCards"/></ScrollViewer><StackPanel x:Name="GalleryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Your next idea starts here" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="Create a drawing or import one you already saved." Foreground="#A6B7CD" Margin="0,12"/><Button Content="Create your first drawing" Click="CreateGalleryDrawing"/></StackPanel></Grid>
  <TextBlock x:Name="GalleryStatus" Grid.Row="3" Foreground="#A6B7CD" Margin="0,18,0,0" TextWrapping="Wrap"/>
 </Grid>
 <Grid x:Name="DrawingNameOverlay" Visibility="Collapsed" Background="#B0000000">
  <Border Width="420" MaxHeight="690" Padding="26" CornerRadius="14" Background="#192230" VerticalAlignment="Center" HorizontalAlignment="Center"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="DrawingNameTitle" Text="Name your drawing" FontSize="24" FontWeight="SemiBold"/><TextBox x:Name="DrawingNameInput" Margin="0,18,0,8" MaxLength="80" KeyDown="DrawingNameKeyDown"/><StackPanel x:Name="CreationOptions" Visibility="Collapsed">
 <TextBlock Text="Canvas size (pixels)" Foreground="#A6B7CD" Margin="0,8,0,4"/><UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Text="Width"/><TextBox x:Name="NewCanvasWidth" Text="640" TextChanged="CanvasSizePreviewChanged"/><Slider x:Name="CanvasWidthSlider" Minimum="128" Maximum="2048" Value="640" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CanvasDimensionSliderChanged" Margin="0,8,0,4" ToolTip="Canvas width"/></StackPanel><StackPanel><TextBlock Text="Height"/><TextBox x:Name="NewCanvasHeight" Text="640" TextChanged="CanvasSizePreviewChanged"/><Slider x:Name="CanvasHeightSlider" Minimum="128" Maximum="2048" Value="640" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CanvasDimensionSliderChanged" Margin="0,8,0,4" ToolTip="Canvas height"/></StackPanel></UniformGrid>
 <TextBlock Text="128–2048 pixels per side · applies to all six views" FontSize="11" Foreground="#A6B7CD" Margin="0,6"/>
 <Grid Height="110" Background="#11151D" Margin="0,4,0,2"><Border x:Name="CanvasSizePreview" Background="White" BorderBrush="#8FA4C2" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="CanvasPreviewLabel" Foreground="#A6B7CD" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" FontSize="11"/></Grid>
 <TextBlock Text="Mesh type" Margin="0,12,0,0"/><ComboBox x:Name="NewOutputType" SelectionChanged="CreationOutputChanged"><ComboBoxItem Content="Static Mesh" IsSelected="True"/><ComboBoxItem Content="Skeletal Mesh"/></ComboBox>
 <StackPanel x:Name="CreationRigOptions" Visibility="Collapsed"><TextBlock Text="Skeleton type"/><ComboBox x:Name="NewSkeletonType"/><TextBlock Text="Use a preset or Custom to draw your own bones. Save your skeleton as a reusable type from the editor." TextWrapping="Wrap" Foreground="#A6B7CD" FontSize="12"/></StackPanel>
 </StackPanel><TextBlock x:Name="DrawingNameError" TextWrapping="Wrap" Foreground="#FF9AA9"/><WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancel" Click="CancelDrawingName"/><Button Content="Save" Click="AcceptDrawingName"/></WrapPanel></StackPanel></ScrollViewer></Border>
 </Grid>
 </Grid>
</Window>
